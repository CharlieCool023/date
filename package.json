{
  "name": "velum",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:privacy": "pnpm --filter @velum/core test:privacy",
    "db:generate": "pnpm --filter @velum/db generate",
    "db:migrate": "pnpm --filter @velum/db migrate",
    "db:seed": "pnpm --filter @velum/db seed",
    "cli": "pnpm --filter @velum/worker cli"
  },
  "devDependencies": {
    "eslint": "^9.24.0",
    "turbo": "^2.5.0",
    "typescript-eslint": "^8.29.1",
    "typescript": "^5.8.3",
    "vitest": "^3.1.1"
  }
}
